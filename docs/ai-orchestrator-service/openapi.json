    "components": {
        "schemas": {
            "ChatRequest": {
                "properties": {
                    "message": {
                        "type": "string",
                        "title": "Message"
                    },
                    "context": {
                        "anyOf": [
                            {
                                "type": "object"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "message"
                ],
                "title": "ChatRequest"
            },
            "ChatResponse": {
                "properties": {
                    "response": {
                        "type": "string",
                        "title": "Response"
                    },
                    "workflow": {
                        "anyOf": [
                            {
                                "type": "object"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Workflow"
                    },
                    "results": {
                        "anyOf": [
                            {
                                "items": {
                                    "type": "object"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Results"
                    },
                    "success": {
                        "type": "boolean",
                        "title": "Success"
                    }
                },
                "type": "object",
                "required": [
                    "response",
                    "success"
                ],
                "title": "ChatResponse"
            },
            "EmergencyAlertRequest": {
                "properties": {
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "default": "MEDICAL_EMERGENCY"
                    },
                    "location": {
                        "type": "string",
                        "title": "Location"
                    },
                    "severity": {
                        "type": "string",
                        "title": "Severity",
                        "default": "HIGH"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description"
                    },
                    "reported_by": {
                        "type": "string",
                        "title": "Reported By"
                    },
                    "latitude": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Latitude"
                    },
                    "longitude": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Longitude"
                    }
                },
                "type": "object",
                "required": [
                    "location",
                    "description",
                    "reported_by"
                ],
                "title": "EmergencyAlertRequest"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "ServiceInfo": {
                "properties": {
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "protocol": {
                        "type": "string",
                        "title": "Protocol"
                    },
                    "port": {
                        "type": "integer",
                        "title": "Port"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description"
                    }
                },
                "type": "object",
                "required": [
                    "name",
                    "protocol",
                    "port",
                    "description"
                ],
                "title": "ServiceInfo"
            },
            "TripPlanRequest": {
                "properties": {
                    "origin": {
                        "type": "string",
                        "title": "Origin"
                    },
                    "destination": {
                        "type": "string",
                        "title": "Destination"
                    },
                    "zone_id": {
                        "type": "string",
                        "title": "Zone Id"
                    }
                },
                "type": "object",
                "required": [
                    "origin",
                    "destination",
                    "zone_id"
                ],
                "title": "TripPlanRequest"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
